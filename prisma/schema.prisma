generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookingService {
  HAND
  FOOT
  BOTH
}

enum BookingLocation {
  SALON
  HOME
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id              String          @id @default(cuid())
  customerName    String
  whatsapp        String
  address         String?
  service         BookingService
  location        BookingLocation
  startAt         DateTime
  endAt           DateTime
  status          BookingStatus   @default(PENDING)
  servicePrice    Int
  mobilityFee     Int             @default(0)
  totalPrice      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([startAt, status])
}
