generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookingService {
  HAND
  FOOT
  BOTH
}

enum BookingLocation {
  SALON
  HOME
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  whatsapp     String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  sessions     Session[]
  loyaltyRewardsAvailable Int @default(0)

  @@index([whatsapp])
}

model Booking {
  id              String          @id @default(cuid())
  customerName    String
  whatsapp        String
  address         String?
  service         BookingService
  location        BookingLocation
  startAt         DateTime
  endAt           DateTime
  status          BookingStatus   @default(PENDING)
  paymentMethod   String?
  loyaltyDiscount Int             @default(0)
  promotionalDiscount Int         @default(0)
  campaignEventId  String?
  servicePrice    Int
  mobilityFee     Int             @default(0)
  totalPrice      Int
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([startAt, status])
  @@index([userId, startAt])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Int
  category    String
  description String
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([occurredAt])
}



model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  yearlyGoal   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
}


model PlatformFeature {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PlatformEvent {
  id              String   @id @default(cuid())
  title           String
  description     String?
  type            String
  discountPercent Int?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type, active, startsAt, endsAt])
}


model Session {
  id          String     @id
  tokenHash   String     @unique
  userId      String?
  adminUserId String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([adminUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}
