# Local SQLite database for Prisma CLI and local development
DATABASE_URL="file:./dev.db"

# Turso hosted database (keep actual values in .env, never commit secrets)
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN="replace-with-your-turso-token"

# Generate a long random secret for signing customer sessions (at least 32 characters)
AUTH_SECRET="replace-with-a-long-random-secret"

# Required to sign customer session cookies (generate a random secret of at least 32 characters)
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Initial administrator credentials, used only by scripts/seed-admin.cjs.
# Run the script once to store the account in Turso; login reads the database.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
