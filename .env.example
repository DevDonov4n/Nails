# Local SQLite database for Prisma CLI and local development
DATABASE_URL="file:./dev.db"

# Turso hosted database (keep actual values in .env, never commit secrets)
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN="replace-with-your-turso-token"

# Generate a long random secret for signing customer sessions (at least 32 characters)
AUTH_SECRET="replace-with-a-long-random-secret"
